# Copy to server/.env and fill in. Never commit the real .env.

# --- required ---
PORT=5000
NODE_ENV=development
# allowed browser origins (CORS), comma separated, e.g. https://nextova.qa,https://www.nextova.qa
CLIENT_URL=http://localhost:5173
# the public website address used in the sitemap (default: the first CLIENT_URL), e.g. https://nextova.store
SITE_URL=
# MongoDB connection string; the database name is the last part of the path (dev: nextova, live: nextova_live)
MONGO_URI=
# long random string (at least 32 characters), e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- picture / video uploads (Cloudinary signed uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- new-order e-mail (Resend), optional ---
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=

# --- WhatsApp Cloud API order receipt, optional ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- only for src/scripts/copyCatalog.js (copy the catalog into another database) ---
TARGET_URI=

# --- testing only: never set these on the live server ---
# MAIL_DRY_RUN=1        # e-mails (orders, reports, alerts) are only written to the log
# WHATSAPP_DRY_RUN=1    # WhatsApp messages are only written to the log
# DISABLE_SCHEDULER=1   # no weekly / monthly report e-mails and no "no orders" alerts from this copy
